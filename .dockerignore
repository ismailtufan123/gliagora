# Keep the build context small and never send local secrets or data to the image.
.git
.github
.next
node_modules
coverage
test-results
playwright-report
.env
.env.*
!.env.example
*.log
.venv-fonts
tools
deploy
*.md
# …except the Markdown pages the site is built from (About, legal texts) and the editor guide
# that the admin shows (src/admin/help.ts)
!content/**/*.md
!docs/editor-guide-tr.md

# End-to-end tests are not part of the image
tests
playwright.config.ts
