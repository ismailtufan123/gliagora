# Settings for backup.sh and restore.sh. Copy to /opt/gliagora/backup/backup.env and run
#   chmod 600 backup.env

# Folder with compose.prod.yml and .env.
COMPOSE_DIR=/opt/gliagora

# Encrypted restic repository. On the server until signups open (PLAN §11.7.1).
RESTIC_REPOSITORY=/var/backups/gliagora/restic
# File with the repository password (one line). Keep a copy in the password manager too:
# without the password nobody, including you, can read the backups.
RESTIC_PASSWORD_FILE=/opt/gliagora/backup/restic-password

# Databases to back up, separated by spaces. Each has a login role with the same name.
# Add listmonk and umami when they exist.
DATABASES="gliagora"

# Group allowed to read the local repository, for the weekly copy to the operator's computer.
# The repository is encrypted, so copying its files is safe.
BACKUP_READ_GROUP=gliagora

# Optional second repository, for example the second VDS from M2 (PLAN §11.7.1):
#   COPY_REPOSITORY=sftp:backup@<second-vds>:/srv/restic/gliagora
#   COPY_PASSWORD_FILE=/opt/gliagora/backup/restic-password-copy
COPY_REPOSITORY=
COPY_PASSWORD_FILE=
