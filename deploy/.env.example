# Production settings for compose.prod.yml. Copy to /opt/gliagora/.env on the server and run
#   chmod 600 .env
# Never commit the real file. Generate each secret with: openssl rand -hex 32
# (hex only: the passwords go into a database URL).

# Domain Caddy serves and gets a certificate for; www.<domain> redirects to it. It also gives the
# app its address (SERVER_URL, https://<domain>): only pages from there may use an editor's session.
SITE_DOMAIN=gliagora.com

# The site's stage (D41, D50), read by Caddy and the app, which compose.prod.yml both give this
# value unchanged: `private` keeps every page behind the site-wide password (until M2); `m2` opens
# the public pages of the M2 state in their M2 versions (README.md, "Switching to the M2 state",
# with its steps first). Write exactly one of the two, without quotes, spaces or a comment after
# it: any other value (also `m2 x`, or `m2` and a tab and a comment) stops Caddy from starting,
# and the app shows the private stage, so a typing mistake opens nothing.
SITE_STAGE=private

# App image from GHCR. Keep `main` here for the first deploy; after that, every deploy records the
# exact image it started (`sha-` + 7 characters of the commit) and keeps the old file as .env.previous.
APP_IMAGE=ghcr.io/ismailtufan123/gliagora:main

# PostgreSQL superuser (maintenance and backups only).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# The app's own database user. Used when the database volume is first created and by the app.
APP_DB_PASSWORD=replace-with-openssl-rand-hex-32

# Signs Payload admin sessions. Changing it signs every editor out. The key that hashes IP
# addresses for the form rate limits is derived from it; changing it only resets those limits.
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32

# Signs the spam-check (ALTCHA) challenges of the public forms. Changing it only makes forms that
# are open at that moment ask for the spam check again.
ALTCHA_HMAC_KEY=replace-with-openssl-rand-hex-32

# listmonk, the Glia Notes newsletter service (M2; README.md, "listmonk"): the password of its own
# database user (listmonk/prepare.sh sets it on every update), and the token of the app's API user
# in listmonk (only its SHA-256 is stored there). The app gets the same token, with listmonk's
# address inside the stack (compose.prod.yml: http://listmonk:9000), for the Glia Notes signup and
# unsubscribe (D50): unsubscribing works with these alone; the signup also needs SMTP_HOST below,
# so it stays off ("signup off (no mail server)" in the app's start line) until the M2 mailbox.
# Changing either takes effect at the next update.sh.
LISTMONK_DB_PASSWORD=replace-with-openssl-rand-hex-32
LISTMONK_API_TOKEN=replace-with-openssl-rand-hex-32

# Optional: a free ROR client ID (https://ror.readme.io/docs/client-id) raises the ROR API rate
# limit when editors add an institution by its ROR ID. Leave empty to use the ROR API without one.
ROR_CLIENT_ID=

# Outgoing email: the outcome of a suggestion and the acknowledgement of a report (M4.7). From M2
# this is the SMTP server of the Turkish mailbox (no separate relay at the start, PLAN §11.7.1,
# D22); until then leave SMTP_HOST empty: nothing is sent, and no address is written to the logs.
# Port 587 needs STARTTLS (required); with SMTP_SECURE=true, TLS from the start (usually port 465).
# Setting SMTP_HOST also switches on member sign-in by email link: first copy the deploy files and
# restart Caddy (deploy/README.md, section 9, step 1); and, with listmonk's settings above, the Glia
# Notes signup: first do deploy/README.md section 14 (its Caddyfile keeps the newsletter's links out
# of the logs).
# Write SMTP_PASS and EMAIL_FROM in single quotes, as below (SMTP_PASS='the password'): Compose
# then takes them exactly as written, and so do listmonk/prepare.sh and backup/alert.sh, which
# refuse a value with $, \, " or # outside single quotes (Compose would change it, and listmonk or
# the backup emails would get another password than the app). A password that contains ' itself
# cannot be written so: change it in the mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=''
EMAIL_FROM='Gliagora <hello@gliagora.com>'

# The cap on the emails the public forms send in all (sign-in links, address and data-request
# confirmations, D49; Glia Notes confirmation links, from the form and "Send it again", D50): whole
# numbers, an hour and a day (the last 23 hours at least). Empty: 50 an hour and 200 a day. At M2,
# set them from the mailbox's sending limit, leaving room for what does not count here: the
# scheduled emails (outcomes, acknowledgements, warnings), the issues of Glia Notes and its welcome
# emails, one per confirmed signup, sent while the person waits. Links work 7 days, so in a rush of
# signups the welcomes of one hour are not bounded by that hour's links: leave as much room again
# for them as the signups take, about half of what remains of the mailbox's limit. The app never goes above a value set here: the hour is never above the day (an empty
# hour with EMAIL_CAP_DAY=40 means 40 an hour and 40 a day; an hour above the day, or above the
# default day when the day is empty, is lowered to the day, with an error line), and a value it
# cannot read is replaced by the stricter of its default and the other setting, with an error line
# naming it. The app's start line says which cap it uses (`Email cap of the forms: …`).
EMAIL_CAP_HOUR=
EMAIL_CAP_DAY=

# The issues of Glia Notes (M11, D53): the seed addresses every test email of an issue also goes
# to, besides the signed-in editor's: the operator's own test accounts at Gmail, Outlook, Yahoo and
# a Turkish provider (PLAN §13), separated by commas, at most 10. Never subscribers' addresses.
GLIA_NOTES_SEED_ADDRESSES=

# Pushing issues of Glia Notes to listmonk (M11, D53; README section 18). The mailbox's own sending
# limits, from its provider (M2), an hour and/or a day: listmonk's sending rate is derived from
# them (deploy/listmonk/settings.sql), keeping a tenth for the scheduled emails and anything sent by
# hand, and twice EMAIL_CAP_* for the forms' links and as many welcome emails. The issues' own API
# user in listmonk (openssl rand -hex 32, another value than LISTMONK_API_TOKEN; empty: the user is
# disabled). GLIA_NOTES_PUSH stays off until the launch: then `on`.
MAILBOX_LIMIT_HOUR=
MAILBOX_LIMIT_DAY=
LISTMONK_CAMPAIGNS_TOKEN=
GLIA_NOTES_PUSH=off

# Member sign-in (M4b, D49). Each way of signing in is off until its settings are set (email links:
# SMTP_HOST above, with ALTCHA_HMAC_KEY); with none, the site says "Signing in is not available
# yet". Set them only with the operator's go-ahead, and only once the server's Caddyfile keeps the
# query strings of sign-in addresses out of its logs (added with the sign-in pages).
# Google: a "Web application" client in the Google Auth Platform, with the redirect address
# https://gliagora.com/en/sign-in/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ORCID: a Public API client (Developer tools on orcid.org), with the redirect address
# https://gliagora.com/en/sign-in/orcid/callback/
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# ORCID's own issuer. ORCID's sandbox is refused on this server.
ORCID_ISSUER=https://orcid.org

# AI drafts through the Claude API (M7, D52; src/lib/ai/claude-api.ts): off until both are set.
# The key is a secret (Claude Console); the cap is a monthly spend limit in US dollars (set one in the
# Console too). CLAUDE_MODEL is optional (default claude-opus-5-5; a cheaper one is the operator's choice).
ANTHROPIC_API_KEY=
AI_MONTHLY_CAP_USD=
CLAUDE_MODEL=
