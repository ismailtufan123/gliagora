# Caddy: HTTPS certificates, security headers, compression, rate limits and privacy-friendly logs
# (PLAN §11.2, §18.2). Certificates come from Let's Encrypt automatically; no email is sent.
# The `rate_limit` directive needs the server's own Caddy image (deploy/caddy-image): the official
# Caddy does not know it and refuses this file.

# What both logs keep of a request (PLAN §18.1, §18.2): the access log and Caddy's own log, which
# also gets the errors of requests (a 502 while the app restarts or a deploy rolls back), with the
# whole address and the visitor's IP address. IP addresses masked (IPv4 to /24, IPv6 to /48), no
# cookies or credentials, no admin or API query strings, reset tokens, or queries in referrers,
# redirect targets and the app's rewrites, and no queries of the sign-in, account, data-request and
# newsletter addresses.
(log_fields) {
	request>remote_ip ip_mask 24 48
	request>client_ip ip_mask 24 48
	# Password-reset links carry a one-time token in the path (/admin/reset/<token>): a credential.
	# Admin list filters and the admin's searches put what an editor types (e.g. an email address
	# for a data request) in the query of /admin and /api addresses. The queries of the member
	# addresses carry one-time tokens (emailed links), Google's and ORCID's answers (code, state)
	# and where sign-in leads (M4b, D49); those of the newsletter addresses the confirmation link's
	# one-time token and a subscriber's listmonk ID and UUID, the unsubscribe credential (M2, D50).
	# src/lib/access.test.ts applies these rules to examples.
	request>uri multi_regexp {
		regexp ^/admin/reset/[^/?]+ /admin/reset/[removed]
		regexp ^(/(?:admin|api)[^?]*)\?.*$ ${1}?[removed]
		regexp ^(/en/(?:sign-in|account|legal/data-requests|newsletter)(?:/[^?]*)?)\?.*$ ${1}?[removed]
	}
	request>headers>Referer multi_regexp {
		regexp /admin/reset/[^/?]+ /admin/reset/[removed]
		regexp \?.*$ ?[removed]
	}
	request>headers>Cookie delete
	request>headers>Authorization delete
	request>headers>X-Forwarded-For delete
	resp_headers>Set-Cookie delete
	# Next.js's trailing-slash redirect (308) repeats the request address in Location and Refresh.
	resp_headers>Location multi_regexp {
		regexp /admin/reset/[^/?]+ /admin/reset/[removed]
		regexp \?.*$ ?[removed]
	}
	resp_headers>Refresh multi_regexp {
		regexp /admin/reset/[^/?]+ /admin/reset/[removed]
		regexp \?.*$ ?[removed]
	}
	# The M2 state shows a public page's M2 version by a rewrite that keeps the query (an emailed
	# link's token, D50), and Next.js repeats the rewritten address with its query in these headers
	# (the first is also removed from the answers, below).
	resp_headers>X-Middleware-Rewrite delete
	resp_headers>X-Nextjs-Rewritten-Query delete
}

# Caddy's own log, on stderr, which Docker keeps: the same filters as the access log, for the
# lines about requests that failed (M4b, D49). Without the rate limiter's own line for each
# request it refuses ("rate limit exceeded"), which names the visitor's whole address: the access
# log already has that request, with its masked address and the 429.
{
	log default {
		output stderr
		format filter {
			import log_fields
		}
		exclude http.handlers.rate_limit
	}
}

(security_headers) {
	header {
		# HSTS without preload for now; add preload after 3 stable months (PLAN §18.2).
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Baseline policy: nothing from other domains. The strict nonce-based policy comes with M1.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
		-X-Powered-By
		# Next.js's own note of a rewrite, with the query of the address (above); browsers do not
		# need it (they read X-Nextjs-Rewritten-Path and -Query, which stay).
		-X-Middleware-Rewrite
		# The app's mark of its public answers in the M2 state, read by caddy/m2-public.caddy only.
		-X-Gliagora-Public
	}
}

# Rate limits per visitor (PLAN §18.2, D42), checked before the password and before the app: a
# guard against floods and guessing, set far above what people do. The app's own limits on the
# forms are much tighter and answer with their own messages (src/lib/forms/rate-limit.ts); these
# only bound what reaches it. Each zone counts the requests of one visitor address over the last
# minute: an IPv4 address, or an IPv6 /64 (one home, campus or phone network; a visitor can pick
# any address inside it). The address is the connection's own: no proxy stands in front of Caddy.
# A request over a limit never reaches the app: it gets 429 with Retry-After (the seconds until
# the next one is let through) and one line of text. Nothing is kept but the times of the last
# requests per address, in memory, for a minute; nothing about it is logged or counted elsewhere
# (the limiter's log line is left out above, its metrics are off).
# tests/e2e/rate-limits.spec.ts sends requests through this file to each zone.
(rate_limits) {
	rate_limit {
		# The editors' sign-in and password routes: Payload's own (sign-in, forgotten and new
		# password, the first account, unlocking) and the admin's pages for them. An editor opens
		# the sign-in page and signs in: three requests.
		zone editors {
			match {
				path /api/users/login /api/users/login/ /api/users/forgot-password /api/users/forgot-password/ /api/users/reset-password /api/users/reset-password/ /api/users/first-register /api/users/first-register/ /api/users/unlock /api/users/unlock/ /admin/login /admin/login/* /admin/forgot /admin/forgot/* /admin/reset /admin/reset/* /admin/create-first-user /admin/create-first-user/*
			}
			key {client_ip}
			ipv6_prefix 64
			window 1m
			events 20
		}
		# Member sign-in (M4b): its pages, the start with Google or ORCID and their answers, the
		# emailed link and "Create account"; and what the account pages' forms send (signed out,
		# they show the sign-in panel in place, whose form posts there). One sign-in is about six
		# requests.
		zone member_sign_in {
			match {
				path /en/sign-in /en/sign-in/*
			}
			match {
				method POST
				path /en/account /en/account/*
			}
			key {client_ip}
			ipv6_prefix 64
			window 1m
			events 120
		}
		# What the public forms send: a suggestion, a report, a data request and its
		# confirmation, the Glia Notes signup, "Send it again" and its confirmation. Not the
		# unsubscribe route: mail providers send their users' one-click unsubscribes from a few
		# addresses of their own (D50).
		zone forms {
			match {
				method POST
				path /en/suggest /en/suggest/ /en/report /en/report/ /en/legal/data-requests /en/legal/data-requests/ /en/legal/data-requests/confirm/use /en/legal/data-requests/confirm/use/ /en/newsletter /en/newsletter/ /en/newsletter/resend /en/newsletter/resend/ /en/newsletter/confirm/use /en/newsletter/confirm/use/
			}
			key {client_ip}
			ipv6_prefix 64
			window 1m
			events 30
		}
		# Search: the search page, and the jobs list and the map's data with words to search for
		# (`q`). One search is one request; nothing is sent while typing.
		zone search {
			match {
				path /en/search /en/search/*
			}
			match {
				path /en/jobs /en/jobs/ /api/map/institutions /api/map/institutions/
				query q=*
			}
			key {client_ip}
			ipv6_prefix 64
			window 1m
			events 120
		}
		disable_metrics
	}

	# The answer to a request over a limit: the status, Retry-After (set by the limiter) and one
	# line, with the site's headers.
	handle_errors 429 {
		import security_headers
		header Content-Type "text/plain; charset=utf-8"
		respond "Too many requests. Please wait a moment and try again." 429
	}
}

# Access logs: the fields above, one file per day, deleted after 14 days (PLAN §18.1).
(access_log) {
	log {
		output file /var/log/caddy/access.log {
			roll_interval 24h
			roll_keep_for 336h
		}
		format filter {
			import log_fields
		}
	}
}

# The site's stage (D41, D50), set by SITE_STAGE in .env, which the app reads too
# (compose.prod.yml passes the same value to both, unchanged, `private` when it is missing or
# empty): `private` opens nothing but the health check; `m2` also opens the public pages of the M2
# state, listed in caddy/m2-public.caddy (written by `pnpm caddy:public` from
# src/lib/public-pages.ts). The import below is quoted, so Caddy reads the whole value as one name,
# as the app does: any other value, also `m2` with a space, a tab or a comment after it, names no
# snippet and no file, and Caddy refuses to start (a value with * or ?, which Caddy reads as a
# pattern of files, matches none and opens nothing either), while the app shows the private stage.
# A misspelt stage opens nothing.
(stage-private) {
}

(stage-m2) {
	import /etc/caddy/m2-public.caddy
}

{$SITE_DOMAIN} {
	import security_headers
	import access_log
	encode zstd gzip
	# The mark of the M2 state's public requests (caddy/m2-public.caddy) comes from Caddy alone.
	request_header -X-Gliagora-Public
	# Before the password and every handle below, in each stage.
	import rate_limits

	# The health check stays open for the uptime monitor (PLAN §18.2). It answers only
	# {"status":"ok"} or {"status":"error"}. Only this one path: anything below it would reach the
	# site's 404 page, with its navigation, without the password.
	@health path /health /health/
	handle @health {
		rewrite * /health/
		reverse_proxy app:3000
	}

	# The map's basemap (M5, PLAN §14): the tiles, fonts and sprites that
	# deploy/basemap/fetch-basemap.sh puts in /opt/gliagora/basemap/public. Its versioned files never
	# change, so browsers keep them; current.json names the current version and is checked on every
	# visit. Private until the map goes public at the launch (M6, D39): then drop the import here.
	@basemap path /basemap/*
	handle @basemap {
		import /etc/caddy/admin-auth.caddy
		# `header` runs before `uri`, so its matchers see the full path.
		@current path /basemap/current.json /basemap/previous.json
		@versioned not path /basemap/current.json /basemap/previous.json
		header @current Cache-Control "no-cache"
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		uri strip_prefix /basemap
		root * /srv/basemap
		file_server {
			hide .*
		}
	}

	# The admin panel and Payload's API are behind a second password (admin-auth.caddy) until the
	# admin has two factors (PLAN §18.2). The API needs it as much as the panel: its sign-in and
	# password-reset routes would otherwise skip the second password, and while no account exists
	# (the first deploy, a restore onto a new server) /api/users/first-register makes one for
	# anybody. The public site never calls /api (its forms post to their own pages); a public API
	# route (the map, M5) gets its own handle above this one. The admin's own /api requests reuse
	# the password the browser keeps for this site.
	@admin path /admin /admin/* /api /api/*
	handle @admin {
		import /etc/caddy/admin-auth.caddy
		reverse_proxy app:3000
	}

	# The public pages of the site's stage (above): none in the private stage.
	import "stage-{$SITE_STAGE:private}"

	# Private until M2 (D32): every other page asks for the same password, so nothing is public or
	# indexed before the privacy texts are live. At M2 only the coming-soon page, the newsletter
	# signup, About and the approved legal texts open, through the stage's snippet above; the rest
	# stays behind the password until the launch gate (PLAN §18.2).
	handle {
		import /etc/caddy/admin-auth.caddy
		reverse_proxy app:3000
	}
}

www.{$SITE_DOMAIN} {
	import security_headers
	redir https://{$SITE_DOMAIN}{uri} 308
}
