# Dependencies
/node_modules

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Environment files: never commit real values (use .env.example)
.env
.env*.local

# Uploads written by Payload in local development
/media

# Tests
/coverage
/test-results/
/playwright-report/

# Lighthouse (tools/lighthouse): its own packages, and the reports of a run
/tools/lighthouse/node_modules/
/lighthouse-reports/

# Logs and OS files
*.log
.DS_Store
*.pem

# Local Python environment for tools/fonts
/.venv-fonts/

# Server-only files (see deploy/README.md)
/deploy/admin-auth.caddy
/deploy/backup/backup.env
/deploy/backup/restic-password
# Deploy key pair, if someone creates it in the repository folder by mistake
gliagora-deploy
gliagora-deploy.pub

# MapLibre GL JS, copied from node_modules at build time (src/scripts/vendor-maplibre.mjs)
/public/map/maplibre-gl/
# The weekly AI drafts' files on the operator's computer (tools/ai-drafts/weekly.sh)
/ai-drafts/
# The files of "Update the jobs" on the operator's computer (tools/update-jobs/update.sh, D59)
/update-jobs/
# The hero's brain model as downloaded (tools/hero/README.md): the build reads it, the repository
