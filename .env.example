# Copy this file to .env and replace every placeholder. Never commit .env.
# Local and staging environments use generated fake data only (CLAUDE.md).

# Local PostgreSQL container (read by `docker compose up -d db`)
POSTGRES_USER=gliagora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gliagora

# Connection string used by the app and the Payload CLI.
# User, password and database must match the three values above.
DATABASE_URL=postgres://gliagora:change-me@localhost:5432/gliagora

# Signs Payload admin sessions. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Signs the spam-check (ALTCHA) challenges of the public forms. At least 32 characters; generate
# one with: openssl rand -hex 32. Without it the "Suggest a listing" form says it is temporarily
# unavailable (the rest of the site works).
ALTCHA_HMAC_KEY=replace-with-openssl-rand-hex-32

# The site's own address (https://…, no trailing slash): the only origin whose requests may use an
# editor's session cookie, and the start of links in Payload's own emails. The production server
# sets it from SITE_DOMAIN (deploy/compose.prod.yml). Leave it empty locally and in CI, so the app
# and its admin work on any port.
SERVER_URL=

# Scheduled jobs (the nightly ROR import, the hourly expiry of listings, the retention purges and
# the automatic emails) run only when this is true: set it on the production server only
# (deploy/compose.prod.yml does). Leave it false locally and in CI; run them once with
# `pnpm jobs:run`.
PAYLOAD_JOBS_AUTORUN=false

# Outgoing email (the outcome of a suggestion, the acknowledgement of a report). Without SMTP_HOST
# nothing is sent and no address is logged. Locally, send to Mailpit, which keeps every message on
# this computer (`docker compose --profile mail up -d mailpit`, then open http://127.0.0.1:8025):
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Gliagora <hello@gliagora.com>

# Optional: a free ROR client ID raises the ROR API rate limit (https://ror.readme.io/docs/client-id).
# ROR_CLIENT_ID=
