# Production settings for compose.prod.yml. Copy to /opt/gliagora/.env on the server and run
#   chmod 600 .env
# Never commit the real file. Generate each secret with: openssl rand -hex 32
# (hex only: the passwords go into a database URL).

# Domain Caddy serves and gets a certificate for; www.<domain> redirects to it. It also gives the
# app its address (SERVER_URL, https://<domain>): only pages from there may use an editor's session.
SITE_DOMAIN=gliagora.com

# App image from GHCR. Keep `main` here for the first deploy; after that, every deploy records the
# exact image it started (`sha-` + 7 characters of the commit) and keeps the old file as .env.previous.
APP_IMAGE=ghcr.io/ismailtufan123/gliagora:main

# PostgreSQL superuser (maintenance and backups only).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# The app's own database user. Used when the database volume is first created and by the app.
APP_DB_PASSWORD=replace-with-openssl-rand-hex-32

# Signs Payload admin sessions. Changing it signs every editor out. The key that hashes IP
# addresses for the form rate limits is derived from it; changing it only resets those limits.
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32

# Signs the spam-check (ALTCHA) challenges of the public forms. Changing it only makes forms that
# are open at that moment ask for the spam check again.
ALTCHA_HMAC_KEY=replace-with-openssl-rand-hex-32

# Optional: a free ROR client ID (https://ror.readme.io/docs/client-id) raises the ROR API rate
# limit when editors add an institution by its ROR ID. Leave empty to use the ROR API without one.
ROR_CLIENT_ID=

# Outgoing email: the outcome of a suggestion and the acknowledgement of a report (M4.7). From M2
# this is the SMTP server of the Turkish mailbox (no separate relay at the start, PLAN §11.7.1,
# D22); until then leave SMTP_HOST empty: nothing is sent, and no address is written to the logs.
# Port 587 needs STARTTLS (required); with SMTP_SECURE=true, TLS from the start (usually port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Gliagora <hello@gliagora.com>
