{
  "name": "gliagora",
  "version": "0.1.0",
  "private": true,
  "description": "Gliagora | Neuroscience – Where neuroscience meets",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "node src/scripts/vendor-maplibre.mjs && cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "node src/scripts/vendor-maplibre.mjs && cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "cross-env NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "payload": "payload",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "ror:import": "payload run src/scripts/ror-import.ts",
    "fake:jobs": "payload run src/scripts/fake-jobs.ts",
    "e2e:editor": "payload run src/scripts/e2e-editor.ts",
    "e2e:member": "payload run src/scripts/e2e-member.ts",
    "fake:oidc": "node --env-file-if-exists=.env tests/fake-oidc/server.ts",
    "jobs:run": "payload run src/scripts/jobs-run.ts",
    "tr:review": "payload run src/scripts/tr-strings-review.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@photostructure/tz-lookup": "11.7.0",
    "@protomaps/basemaps": "5.7.2",
    "altcha-lib": "2.5.0",
    "graphql": "16.14.2",
    "maplibre-gl": "6.11.2",
    "marked": "18.0.14",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "oauth4webapi": "3.8.8",
    "payload": "3.90.2",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/yauzl": "3.4.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
